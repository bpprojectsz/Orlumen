    <string name="perm_overlay_title">הצגה מעל אפליקציות אחרות</string>
    <string name="perm_overlay_message">Orlumen מצייר את אורות הקצה מעל אפליקציות אחרות. Android מבקש שתאשרו זאת בהגדרות.</string>
    <string name="perm_microphone_title">האזנה למוזיקה שלכם</string>
    <string name="perm_microphone_message">Orlumen מנתח את האודיו שהטלפון מנגן כדי להניע את האורות. האודיו מעובד במכשיר שלכם בזמן אמת ואינו מוקלט, נשמר או נשלח לשום מקום.</string>
    <string name="perm_notification_access_title">לראות מה מתנגן</string>
    <string name="perm_notification_access_message">גישה להתראות מאפשרת ל-Orlumen לקרוא את הרצועה הנוכחית, את עטיפת האלבום ואת מצב ההשמעה כדי להתאים צבעים ולהציג את כרטיס המוזיקה. Orlumen אינו קורא או שומר את תוכן ההתראות שלכם.</string>
    <string name="perm_usage_access_title">לדעת איזו אפליקציה פתוחה</string>
    <string name="perm_usage_access_message">גישה לנתוני שימוש מאפשרת ל-Orlumen להסתיר את האורות מעל משחקים וסרטונים, או להציג אותם רק מעל אפליקציות שבחרתם. היא בודקת רק איזו אפליקציה נמצאת בחזית.</string>
    <string name="perm_notifications_title">הצגת התראת הסטטוס</string>
    <string name="perm_notifications_message">Android דורש התראה בזמן ש-Orlumen פועל ברקע. היא גם מספקת כפתור עצירה.</string>
    <string name="perm_battery_title">להשאיר אותו פועל</string>
    <string name="perm_battery_message">בחלק מהטלפונים אפליקציות ברקע נעצרות כדי לחסוך בסוללה. אישור לפעול ללא הגבלה מונע מהאורות להיעצר מעצמם.</string>
    <string name="perm_screen_capture_title">לכידת אודיו של אפליקציות</string>
    <string name="perm_screen_capture_message">אפשר להציג ויזואליזציה של חלק מאפליקציות המוזיקה רק על ידי לכידת האודיו שהן מנגנות. Android מציג הודעה משלו בכל פעם. Orlumen אינו מקליט או צופה במסך שלכם לעולם.</string>
