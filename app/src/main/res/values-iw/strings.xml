    <string name="onboarding_body_1">Orlumen הופך את המוזיקה שאתם מנגנים לאורות חיים סביב המסך ולשעון שתמיד דולק.</string>
    <string name="onboarding_title_2">התאימו אישית</string>
    <string name="onboarding_body_2">בחרו מבין סגנונות אורות קצה ומסעי שעון, התאימו את הצבעים לעטיפת האלבום וכווננו כל פרט.</string>
    <string name="onboarding_title_3">שואלים רק כשצריך</string>
    <string name="onboarding_body_3">Orlumen מבקש הרשאה רק ברגע שפיצ׳ר זקוק לה, ותמיד מסביר קודם למה.</string>
