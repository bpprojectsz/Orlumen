    <string name="perm_overlay_title">Sobrepor a outros apps</string>
    <string name="perm_overlay_message">O Orlumen desenha as luzes de borda por cima de outros apps. O Android pede que permita isto nas Definições.</string>
    <string name="perm_microphone_title">Ouvir a sua música</string>
    <string name="perm_microphone_message">O Orlumen analisa o áudio que o telemóvel está a reproduzir para animar as luzes. O áudio é processado no seu dispositivo em tempo real e nunca é gravado, guardado nem enviado para lado nenhum.</string>
    <string name="perm_notification_access_title">Ver o que está a tocar</string>
    <string name="perm_notification_access_message">O acesso às notificações permite ao Orlumen ler a faixa atual, a capa do álbum e o estado da reprodução para combinar as cores e mostrar o cartão de música. O Orlumen não lê nem guarda o conteúdo das suas notificações.</string>
    <string name="perm_usage_access_title">Saber que app está aberto</string>
    <string name="perm_usage_access_message">O acesso de utilização permite ao Orlumen ocultar as luzes em jogos e vídeos, ou mostrá-las apenas sobre os apps que escolher. Só verifica qual app está em primeiro plano.</string>
    <string name="perm_notifications_title">Mostrar a notificação de estado</string>
    <string name="perm_notifications_message">O Android precisa de uma notificação enquanto o Orlumen funciona em segundo plano. Também lhe dá um botão para parar.</string>
    <string name="perm_battery_title">Manter em execução</string>
    <string name="perm_battery_message">Alguns telemóveis param os apps em segundo plano para poupar bateria. Permitir que o Orlumen funcione sem restrições evita que as luzes parem sozinhas.</string>
    <string name="perm_screen_capture_title">Capturar áudio de apps</string>
    <string name="perm_screen_capture_message">Alguns apps de música só podem ser visualizados capturando o áudio que reproduzem. O Android mostra o seu próprio aviso de cada vez. O Orlumen nunca grava nem vê o seu ecrã.</string>
    <string name="palette_wallpaper">Imagem de fundo</string>
