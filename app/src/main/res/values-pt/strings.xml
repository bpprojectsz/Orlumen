    <string name="onboarding_setup">Começar</string>
    <string name="onboarding_title_1">Ilumine as bordas do seu ecrã</string>
    <string name="onboarding_body_1">O Orlumen transforma a música que ouve em luzes ao vivo à volta do ecrã e num relógio sempre visível.</string>
    <string name="onboarding_title_2">Faça à sua maneira</string>
    <string name="onboarding_body_2">Escolha estilos de luzes de borda e mostradores de relógio, combine as cores com a capa do álbum e ajuste cada detalhe.</string>
    <string name="onboarding_title_3">Pedido só quando necessário</string>
    <string name="onboarding_body_3">O Orlumen só pede uma permissão no momento em que uma função precisa dela e explica sempre o motivo primeiro.</string>
