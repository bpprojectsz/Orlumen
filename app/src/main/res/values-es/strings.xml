    <string name="perm_overlay_title">Mostrar sobre otras apps</string>
    <string name="perm_overlay_message">Orlumen dibuja las luces de borde encima de otras apps. Android te pide permitirlo en Ajustes.</string>
    <string name="perm_microphone_title">Escuchar tu música</string>
    <string name="perm_microphone_message">Orlumen analiza el audio que reproduce tu teléfono para animar las luces. El audio se procesa en tu dispositivo en tiempo real y nunca se graba, almacena ni envía a ningún sitio.</string>
    <string name="perm_notification_access_title">Ver qué suena</string>
    <string name="perm_notification_access_message">El acceso a notificaciones permite a Orlumen leer la canción actual, la carátula y el estado de reproducción para combinar colores y mostrar la tarjeta de música. Orlumen no lee ni guarda el contenido de tus notificaciones.</string>
    <string name="perm_usage_access_title">Saber qué app está abierta</string>
    <string name="perm_usage_access_message">El acceso de uso permite a Orlumen ocultar las luces en juegos y vídeos, o mostrarlas solo sobre las apps que elijas. Solo comprueba qué app está en primer plano.</string>
    <string name="perm_notifications_title">Mostrar la notificación de estado</string>
    <string name="perm_notifications_message">Android necesita una notificación mientras Orlumen funciona en segundo plano. También te da un botón para detenerlo.</string>
    <string name="perm_battery_title">Mantenerlo activo</string>
    <string name="perm_battery_message">Algunos teléfonos detienen las apps en segundo plano para ahorrar batería. Permitir que Orlumen funcione sin restricciones evita que las luces se detengan solas.</string>
    <string name="perm_screen_capture_title">Capturar audio de apps</string>
    <string name="perm_screen_capture_message">Algunas apps de música solo se pueden visualizar capturando el audio que reproducen. Android muestra su propio aviso cada vez. Orlumen nunca graba ni ve tu pantalla.</string>
