    <string name="onboarding_skip">Passer</string>
    <string name="onboarding_next">Suivant</string>
    <string name="onboarding_setup">Commencer</string>
    <string name="onboarding_title_1">Illuminez les bords de votre écran</string>
    <string name="onboarding_body_1">Orlumen transforme la musique que vous écoutez en lumières vivantes autour de votre écran et en horloge toujours affichée.</string>
    <string name="onboarding_title_2">Faites-en le vôtre</string>
    <string name="onboarding_body_2">Choisissez parmi des styles de lumières et des cadrans d’horloge, assortissez les couleurs à la pochette de l’album et réglez chaque détail.</string>
    <string name="onboarding_title_3">Demandé seulement quand il le faut</string>
    <string name="onboarding_body_3">Orlumen ne demande une autorisation qu’au moment où une fonction en a besoin, et vous explique toujours pourquoi avant.</string>
