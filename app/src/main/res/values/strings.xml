    <string name="onboarding_title_1">Light up your screen edges</string>
    <string name="onboarding_body_1">Orlumen turns the music you play into live lights around your screen and into an always-on clock.</string>
    <string name="onboarding_title_2">Make it yours</string>
    <string name="onboarding_body_2">Pick from edge-light styles and clock faces, match the colors to your album art, and tune every detail.</string>
    <string name="onboarding_title_3">Asked only when needed</string>
    <string name="onboarding_body_3">Orlumen only asks for a permission at the moment a feature needs it, and always tells you why first.</string>
    <string name="perm_hub_title">Permissions</string>
    <string name="perm_hub_intro">Allow what Orlumen needs. You can change any of these later in Android settings.</string>
