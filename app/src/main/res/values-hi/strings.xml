    <string name="perm_overlay_title">अन्य ऐप्स के ऊपर दिखाएँ</string>
    <string name="perm_overlay_message">Orlumen एज लाइट्स को अन्य ऐप्स के ऊपर दिखाता है। Android आपसे सेटिंग में इसकी अनुमति देने को कहता है।</string>
    <string name="perm_microphone_title">आपका संगीत सुनना</string>
    <string name="perm_microphone_message">Orlumen लाइट्स को एनिमेट करने के लिए आपके फ़ोन पर चल रही ऑडियो का विश्लेषण करता है। ऑडियो आपके डिवाइस पर रीयल टाइम में प्रोसेस होती है और कभी रिकॉर्ड, सेव या कहीं भेजी नहीं जाती।</string>
    <string name="perm_notification_access_title">देखें क्या चल रहा है</string>
    <string name="perm_notification_access_message">नोटिफ़िकेशन एक्सेस से Orlumen मौजूदा ट्रैक, एल्बम आर्ट और प्लेबैक स्थिति पढ़ सकता है, ताकि रंग मिला सके और म्यूज़िक कार्ड दिखा सके। Orlumen आपके नोटिफ़िकेशन की सामग्री न पढ़ता है, न सहेजता है।</string>
    <string name="perm_usage_access_title">जानें कौन-सा ऐप खुला है</string>
    <string name="perm_usage_access_message">उपयोग एक्सेस से Orlumen गेम और वीडियो पर लाइट्स छिपा सकता है, या उन्हें सिर्फ़ आपके चुने ऐप्स पर दिखा सकता है। यह केवल जाँचता है कि कौन-सा ऐप सामने है।</string>
    <string name="perm_notifications_title">स्थिति नोटिफ़िकेशन दिखाएँ</string>
    <string name="perm_notifications_message">Orlumen के बैकग्राउंड में चलने के दौरान Android को एक नोटिफ़िकेशन चाहिए। इससे आपको रोकें बटन भी मिलता है।</string>
    <string name="perm_battery_title">इसे चालू रखें</string>
    <string name="perm_battery_message">कुछ फ़ोन बैटरी बचाने के लिए बैकग्राउंड ऐप्स बंद कर देते हैं। Orlumen को बिना प्रतिबंध चलने देने से लाइट्स अपने-आप बंद नहीं होतीं।</string>
    <string name="perm_screen_capture_title">ऐप ऑडियो कैप्चर करें</string>
    <string name="perm_screen_capture_message">कुछ म्यूज़िक ऐप्स को केवल उनकी चलाई जा रही ऑडियो कैप्चर करके विज़ुअलाइज़ किया जा सकता है। Android हर बार अपना संकेत दिखाता है। Orlumen कभी आपकी स्क्रीन रिकॉर्ड नहीं करता और न देखता है।</string>
    <string name="palette_wallpaper">वॉलपेपर</string>
    <string name="onboarding_skip">छोड़ें</string>
